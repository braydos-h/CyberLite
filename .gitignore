# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Model weights and large artifacts (never commit these)
models/
checkpoints/
runs/
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.onnx
*.ckpt
adapter_model.*
optimizer.pt
scheduler.pt

# Datasets: keep manifests and the tiny smoke set, not bulk data
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/README.md
data/evaluation/*
!data/evaluation/.gitkeep
!data/evaluation/README.md
!data/evaluation/smoke_eval.jsonl
!data/evaluation/baseline_probe_v1.jsonl
!data/evaluation/*.meta.json
# Frozen held-out sets authored independently of the training packs.
!data/evaluation/cyberlite_eval_*_v1.jsonl
!data/evaluation/cyberlite_eval_*_v1.meta.json

# Third-party benchmark items: local only, never redistributed
benchmarks/*/*.json
benchmarks/*/*.jsonl

# Experiment outputs
results/**/*.json
results/**/*.jsonl
results/**/*.csv
!results/tables/.gitkeep
# Small baseline artifacts are committed so reviewers can verify the hashes
# quoted in results/*/README.md from a clean clone. Keep this list explicit:
# unignoring a whole directory can republish restricted benchmark items.
!results/baseline/e0-instruct-probe/summary.json
!results/baseline/e0-instruct-probe/predictions.jsonl
!results/baseline/e0-instruct-probe/inference_benchmark.json
!results/baseline/e0-instruct-smoke/summary.json
!results/baseline/e0-instruct-smoke/predictions.jsonl
!results/baseline/e0-instruct-seceval/summary.json
# GPU bring-up reports are small and are required by docs/gpu-bringup.md.
!results/bringup/**/*.json
!results/bringup/**/*.jsonl
experiments/*/
!experiments/README.md

# Secrets and local state
.env
.env.*
*.pem
*.key
secrets.yaml
wandb/
.hf/
.cache/
# Local environment capture written by docs/gpu-bringup.md
/environment.lock.txt
/hardware.json

# Local design/QA tooling: contains a real browser profile (history, cookies,
# login databases). Never commit it.
web/.taste-skill/
.wrangler/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# LaTeX build products
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.xdv
paper/*.bcf
paper/*.run.xml
paper/*.synctex.gz
paper/*.toc
paper/sections/*.aux

# Dataset acquisition cache and local review artifacts (never commit raw text)
data/cache/
**/review_samples.jsonl
**/review_summary.json
