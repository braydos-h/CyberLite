{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/braydos-h/CyberLite/data/synthesis/knowledge/_schema.json",
  "title": "CyberLite synthesis knowledge pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "domain", "display_name", "author", "facts"],
  "properties": {
    "schema_version": {"const": 1},
    "domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "display_name": {"type": "string", "minLength": 3},
    "author": {"type": "string", "minLength": 3},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subtopic", "difficulty", "title", "fact", "references"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "subtopic": {"type": "string", "minLength": 2},
          "difficulty": {"enum": ["foundational", "intermediate", "advanced", "expert"]},
          "title": {"type": "string", "minLength": 8, "maxLength": 160},
          "fact": {"type": "string", "minLength": 80, "maxLength": 2400},
          "details": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 8}},
          "pitfalls": {"type": "array", "maxItems": 6, "items": {"type": "string", "minLength": 8}},
          "commands": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["language", "code", "purpose"],
              "properties": {
                "language": {"enum": ["bash", "powershell", "sql", "yaml", "json", "nginx", "nftables", "sshd_config", "dockerfile", "kubernetes", "toml", "ini", "http"]},
                "code": {"type": "string", "minLength": 2, "maxLength": 1200},
                "purpose": {"type": "string", "minLength": 8, "maxLength": 300}
              }
            }
          },
          "configs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["language", "snippet", "purpose"],
              "properties": {
                "language": {"type": "string", "minLength": 2, "maxLength": 32},
                "snippet": {"type": "string", "minLength": 2, "maxLength": 2000},
                "purpose": {"type": "string", "minLength": 8, "maxLength": 300}
              }
            }
          },
          "code": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["language", "vulnerable", "secure", "issue"],
              "properties": {
                "language": {"enum": ["python", "javascript", "typescript", "go", "rust", "c", "bash", "powershell", "sql", "java", "php"]},
                "vulnerable": {"type": "string", "minLength": 10, "maxLength": 3000},
                "secure": {"type": "string", "minLength": 10, "maxLength": 3000},
                "issue": {"type": "string", "minLength": 20, "maxLength": 800}
              }
            }
          },
          "logs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["context", "text", "reading"],
              "properties": {
                "context": {"type": "string", "minLength": 3, "maxLength": 160},
                "text": {"type": "string", "minLength": 10, "maxLength": 2500},
                "reading": {"type": "string", "minLength": 40, "maxLength": 1200}
              }
            }
          },
          "mcqs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["question", "options", "answer", "rationale"],
              "properties": {
                "question": {"type": "string", "minLength": 12, "maxLength": 600},
                "options": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 400}},
                "answer": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
                "rationale": {"type": "string", "minLength": 40, "maxLength": 1200}
              }
            }
          },
          "misconceptions": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["claim", "correction"],
              "properties": {
                "claim": {"type": "string", "minLength": 10, "maxLength": 500},
                "correction": {"type": "string", "minLength": 40, "maxLength": 1200}
              }
            }
          },
          "references": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "publisher", "url", "license"],
              "properties": {
                "title": {"type": "string", "minLength": 4, "maxLength": 240},
                "publisher": {"type": "string", "minLength": 2, "maxLength": 120},
                "url": {"type": "string", "pattern": "^https?://"},
                "license": {"type": "string", "minLength": 2, "maxLength": 80}
              }
            }
          },
          "tags": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 2, "maxLength": 40}}
        }
      }
    }
  }
}
